# Vercel precisa do código-fonte para executar `flutter build web`.
# Então NÃO ignore `lib/`, `web/`, `pubspec.yaml`, `pubspec.lock`, etc.

# Tooling / artefatos locais
.dart_tool
.idea
.agents
*.iml

# Segredos (não enviar)
.env
.env*.local

# Build local (o Vercel vai gerar o próprio `build/web` no build)
build

# Pastas de outras plataformas (opcional ignorar pra web)
android
ios
linux
macos
windows

# Misc (opcional)
README.md
*.sql

# Arquivos grandes de planejamento (não usados no build)
vitta-online-v2-plano-projectlibre.csv
vitta-online-v2-plano-projectlibre.xml
